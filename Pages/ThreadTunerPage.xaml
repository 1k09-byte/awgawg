<Page
    x:Class="stellarisKIT.Pages.ThreadTunerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:stellarisKIT.Pages"
    xmlns:models="using:stellarisKIT.Models"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    NavigationCacheMode="Enabled">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <!-- Process Row Template -->
        <DataTemplate x:Key="ProcessRowTemplate" x:DataType="models:TunerProcessRow">
            <Grid Padding="4,8" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="ProcessMenu_Opening">
                        <MenuFlyoutItem Text="Terminate" Click="Action_Terminate" />
                        <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                        <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Priority >">
                            <MenuFlyoutItem Text="High" Click="Action_Priority" Tag="High" />
                            <MenuFlyoutItem Text="Above normal" Click="Action_Priority" Tag="AboveNormal" />
                            <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                            <MenuFlyoutItem Text="Below normal" Click="Action_Priority" Tag="BelowNormal" />
                            <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                        <MenuFlyoutItem Text="Show current settings" Click="Action_ShowSettings" />
                        <MenuFlyoutSubItem Text="Priority boost >">
                            <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                            <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Threads..." Click="Action_Threads" />
                        <MenuFlyoutItem Text="Create rule..." Click="Action_CreateRule" />
                        <MenuFlyoutItem Text="Show details" Click="Action_Details" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid Width="20" Height="20">
                        <PathIcon Data="M2,2v20h20V2H2z" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="16" Height="16" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="20" Height="20" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind CpuPercent, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        
        <!-- Rule Row Template -->
        <DataTemplate x:Key="RuleRowTemplate" x:DataType="models:TunerProfile">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,0,1">
                <Grid Padding="12,10" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind Pattern}" DoubleTapped="RuleRow_DoubleTapped">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Edit" Click="RuleEdit_Click" />
                            <MenuFlyoutItem Text="Enable / disable" Click="RuleToggle_Click" />
                            <MenuFlyoutItem Text="Apply now" Click="RuleApplyNow_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Delete" Click="RuleDelete_Click" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProcessActionsSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ThreadRulesSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind StatusText, Mode=OneWay}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Action Bar -->
            <RowDefinition Height="Auto" /> <!-- TopNav -->
            <RowDefinition Height="Auto" /> <!-- Headers -->
            <RowDefinition Height="*" />    <!-- Process Grid -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Grid Grid.Row="0" Margin="16,16,16,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Processes" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <AutoSuggestBox Width="240" PlaceholderText="Search processes" QueryIcon="Find" VerticalAlignment="Center" />
                <Button Content="Name  ↑" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="0" Width="140" VerticalAlignment="Center">
                    <ComboBoxItem Content="All processes" />
                    <ComboBoxItem Content="Active processes" />
                </ComboBox>
                <ComboBox SelectedIndex="0" Width="80" VerticalAlignment="Center">
                    <ComboBoxItem Content="2 s" />
                    <ComboBoxItem Content="1 s" />
                    <ComboBoxItem Content="5 s" />
                </ComboBox>
            </StackPanel>
            
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Pause" VerticalAlignment="Center" />
                <Button Padding="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24">
                <Button x:Name="TabProcesses" Content="Processes" Style="{StaticResource TextBlockButtonStyle}" Click="TabNav_Click" Tag="Processes" Foreground="{ThemeResource SystemAccentColorLight2}" FontWeight="Bold" FontSize="16" />
                <Button x:Name="TabRules" Content="Rules" Style="{StaticResource TextBlockButtonStyle}" Click="TabNav_Click" Tag="Rules" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" FontSize="16" />
                <Button x:Name="TabReservedCpuSets" Content="Core Reservation" Style="{StaticResource TextBlockButtonStyle}" Click="TabNav_Click" Tag="ReservedCpuSets" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>
            <!-- Gaming mode: boost selected process + lower background load, with restore -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="PageGamingStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="PageGamingModeButton" Content="Enable Gaming mode" Style="{StaticResource AccentButtonStyle}" Click="Page_ToggleGamingMode" MinWidth="150" Padding="12,4"
                        ToolTipService.ToolTip="Raises the selected process to Above Normal and lowers other background processes to Below Normal. Select a process row first."/>
                <Button x:Name="PageRestoreButton" Content="Restore" Click="Page_RestorePriorities" IsEnabled="False" Padding="12,4"
                        ToolTipService.ToolTip="Revert every priority stellarisKIT changed (Gaming mode lowering and CPU-bound auto-raise)."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTipService.ToolTip="Keep the app running so rules apply automatically">
                <TextBlock Text="Start with Windows" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="StartupToggle" VerticalAlignment="Center" Toggled="StartupToggle_Toggled" />
            </StackPanel>
        </Grid>

        <!-- Column Headers -->
        <Border x:Name="ProcessesHeader" Grid.Row="2" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,1,0,1" Padding="12,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="CPU" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="PID" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="Memory" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="Threads" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="Priority" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="6" Text="State" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="7" Text="Context switches delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="8" Text="Cycles delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Process DataGrid Replacement via ListView -->
        <ListView x:Name="ProcessesGrid" Grid.Row="3" ItemsSource="{x:Bind ViewModel.Processes}" SelectionMode="Single" SelectionChanged="ProcessesGrid_SelectionChanged" ShowsScrollingPlaceholders="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TunerProcessRow">
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,0,1">
                    <Grid Padding="4,8" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}" DoubleTapped="Row_DoubleTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ProcessMenu_Opening">
                                <MenuFlyoutItem Text="Terminate" Click="Action_Terminate" />
                                <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                                <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="Priority   >">
                                    <MenuFlyoutItem Text="Real time" Click="Action_Priority" Tag="Realtime" />
                                    <MenuFlyoutItem Text="High" Click="Action_Priority" Tag="High" />
                                    <MenuFlyoutItem Text="Above normal" Click="Action_Priority" Tag="AboveNormal" />
                                    <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                                    <MenuFlyoutItem Text="Below normal" Click="Action_Priority" Tag="BelowNormal" />
                                    <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                                        <MenuFlyoutSubItem Text="Priority boost   >">
                                    <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                                    <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="Efficiency mode   >">
                                    <MenuFlyoutItem Text="Enabled" Click="Action_Eco" Tag="Enabled" />
                                    <MenuFlyoutItem Text="Disabled" Click="Action_Eco" Tag="Disabled" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Threads..." Click="Action_Threads" />
                                <MenuFlyoutItem Text="Create rule..." Click="Action_CreateRule" />
                                <MenuFlyoutItem Text="Show details" Click="Action_Details" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                            <Grid Width="16" Height="16">
                                <PathIcon Data="M2,2v20h20V2H2z" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="16" Height="16" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="16" Height="16" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind CpuPercent, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Pid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Memory, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Threads, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind PriorityText, Mode=OneWay}" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind State, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind ContextSwitchesDelta, Mode=OneWay}" />
                        <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind CyclesDelta, Mode=OneWay}" />
                    </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Rules Panel -->
        <Grid x:Name="RulesPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Rules toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,4,16,12" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Rules" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBox Width="240" PlaceholderText="Search rules" VerticalAlignment="Center"
                         Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Add rule" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="RuleAdd_Click" />
                <Button Content="Presets…" VerticalAlignment="Center" Click="RulePresets_Click" />
                <Button Content="Edit" VerticalAlignment="Center" Click="RuleEdit_Click" />
                <Button Content="Enable / disable" VerticalAlignment="Center" Click="RuleToggle_Click" />
                <Button Content="Delete" VerticalAlignment="Center" Click="RuleDelete_Click" />
            </StackPanel>

            <!-- Rules column headers -->
            <Border Grid.Row="1" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,1,0,1" Padding="12,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Process actions" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Thread rules" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Last result" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Rules list -->
            <ListView x:Name="RulesList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.DisplayedProfiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                      ItemTemplate="{StaticResource RuleRowTemplate}"
                      SelectionMode="Single" ShowsScrollingPlaceholders="False" DoubleTapped="RuleRow_DoubleTapped" />

            <!-- Rules footer -->
            <Grid Grid.Row="3" Margin="24,12,24,12">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock x:Name="RulesCountText" Text="0 rules" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Each action is applied and verified independently" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Double-click to edit" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Reserved CPU Sets Panel -->
        <Frame x:Name="ReservedCpuSetsFrame" Grid.Row="3" Visibility="Collapsed" Margin="24,12,24,12" />

        <Grid x:Name="ProcessesFooter" Grid.Row="4" Margin="24,12,24,12">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Text="Updated 2 s" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
