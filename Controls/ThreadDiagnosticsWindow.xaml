<Window
    x:Class="stellarisKIT.Controls.ThreadDiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:stellarisKIT.Models"
    xmlns:local="using:stellarisKIT.Controls">

    <Grid x:Name="RootGrid" Background="Transparent" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Threads   |" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProcessNameText" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="|" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="PidText" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="GamingModePanel" Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                <!-- Keep the actions on the top line; game-only controls sit directly beneath them. -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="GamingModeButton" Content="Enable Gaming mode" Style="{StaticResource AccentButtonStyle}" Click="Action_ToggleGamingMode" Padding="12,4" MinWidth="150"/>
                    <Button x:Name="RestoreButton" Content="Restore" Click="Action_RestorePriorities" Padding="12,4" IsEnabled="False" ToolTipService.ToolTip="Revert every priority stellarisKIT changed (Gaming mode lowering and CPU-bound auto-raise)."/>
                </StackPanel>
                <TextBlock x:Name="CpuBoundText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Main Threads Grid -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Headers -->
                <Grid Padding="12,8" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,0,1" Background="{ThemeResource LayerFillColorAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TID" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Context switches delta" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Cycles delta" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Start address" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="Description" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="6" Text="Relative" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="7" Text="Base" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="Dynamic" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="9" Text="State" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ListView x:Name="ThreadsList" Grid.Row="1" ItemsSource="{x:Bind Threads, Mode=OneWay}" SelectionMode="Single" SelectionChanged="ThreadsList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ThreadDiagnosticRow">
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,0,1">
                            <Grid Padding="8,6" ColumnSpacing="12" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="ThreadMenu_Opening">
                                        <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                                        <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Set Priority">
                                            <MenuFlyoutItem Text="Time Critical" Click="Action_Priority" Tag="TimeCritical" />
                                            <MenuFlyoutItem Text="Highest" Click="Action_Priority" Tag="Highest" />
                                            <MenuFlyoutItem Text="Above Normal" Click="Action_Priority" Tag="AboveNormal" />
                                            <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                                            <MenuFlyoutItem Text="Below Normal" Click="Action_Priority" Tag="BelowNormal" />
                                            <MenuFlyoutItem Text="Lowest" Click="Action_Priority" Tag="Lowest" />
                                            <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Efficiency mode">
                                            <MenuFlyoutItem Text="Enabled" Click="Action_Efficiency" Tag="Enabled" />
                                            <MenuFlyoutItem Text="Disabled" Click="Action_Efficiency" Tag="Disabled" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Priority boost">
                                            <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                                            <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                                        <MenuFlyoutItem Text="Show current settings" Click="Action_ShowSettings" />
                                        <MenuFlyoutItem Text="Create rule..." />
                                        <MenuFlyoutItem Text="Refresh" Click="Action_Refresh" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Tid, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SwitchesText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CyclesText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind StartAddress, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Description, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Relative, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Base, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="{x:Bind Dynamic, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="9" Text="{x:Bind State, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Bottom Panel -->
        <Grid Grid.Row="2" Margin="0,16,0,16" Padding="12" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Start address" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SelectedStartAddressText" Text="Select a thread" FontSize="12"/>
                <TextBlock x:Name="SelectedPhysicalPathText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Thread" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SelectedStateText" Text="State      -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedStartedText" Text="Started    -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedDescText" Text="Description -" FontSize="12" FontFamily="Consolas"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Usage" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SelectedCyclesText" Text="Cycles    -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedSwitchesText" Text="Switches  -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedKernelUserText" Text="Kernel    -    User       -" FontSize="12" FontFamily="Consolas"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="Scheduling" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SelectedRelativeText" Text="Relative   -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedBaseText" Text="Base       -    Dynamic    -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedAffinityText" Text="Affinity   -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedBoostText" Text="Boost      -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedEfficiencyText" Text="Efficiency -" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="SelectedCurrentSettingsText" Text="Settings    -" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="ThreadCountText" Text="0 threads   |   1 s sample" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="GamingModeStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Right-click a thread for actions" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
